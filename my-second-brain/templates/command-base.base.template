filters:
  and:
    - file.folder != "99_Meta/Templates"
views:
  - type: table
    name: This Week
    filters:
      and:
        - cb == "task"
        - status != "done"
    order:
      - file.name
      - status
      - due
      - priority
    sort:
      - property: due
        direction: ASC
    columnSize:
      file.name: 328
  - type: table
    name: Today
    filters:
      and:
        - cb == "task"
        - due <= today()
        - status != "done"
    order:
      - file.name
      - status
      - due
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Waiting For
    filters:
      and:
        - cb == "task"
        - status == "waiting"
    order:
      - file.name
      - waiting_on
      - due
  - type: table
    name: Blocked
    filters:
      and:
        - cb == "task"
        - status == "blocked"
    order:
      - file.name
      - depends_on
      - due
  - type: table
    name: Red Flags
    filters:
      and:
        - cb == "task"
        - due < today()
        - status != "done"
    order:
      - file.name
      - due
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Projects
    filters:
      and:
        - type == "brief"
        - status == "active"
    order:
      - file.name
      - stage
      - due
      - owner
    sort:
      - property: due
        direction: ASC
  - type: table
    name: Decisions
    filters:
      and:
        - cb == "decision"
        - status == "active"
    order:
      - file.name
      - date
      - domain
      - lane
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Renewals
    filters:
      and:
        - renew_by != null
    order:
      - file.name
      - type
      - renew_by
    sort:
      - property: renew_by
        direction: ASC
